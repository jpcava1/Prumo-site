# Copie para .env.local e preencha. Sem estas duas variáveis o site roda em
# MODO DEMONSTRAÇÃO (dados fictícios em memória, nada é salvo).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Site da Farmashop (página própria dela, em outro domínio e CNPJ).
# O botão "Pedir na Farmashop" só abre este endereço em nova aba. Nada é enviado.
VITE_FARMASHOP_URL=https://www.farmashop.com.br/enviar-receita

# Analytics próprio (opcional). Pixels de anúncio só carregam em páginas públicas
# e depois do aceite de cookies.
VITE_POSTHOG_KEY=
VITE_META_PIXEL_ID=
VITE_GA_ID=

# ---------------------------------------------------------------------------
# Segredos das Edge Functions (NÃO vão para o front-end).
# Configure com: supabase secrets set NOME=valor
# ---------------------------------------------------------------------------
# ASAAS_API_KEY=            # chave da conta da PRUMO no gateway
# ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# ASAAS_WEBHOOK_TOKEN=      # token configurado no webhook do Asaas
# RESEND_API_KEY=           # e-mail transacional
# EMAIL_FROM="Prumo <consultas@seudominio.com.br>"
# WHATSAPP_API_URL=         # endpoint do parceiro oficial (BSP)
# WHATSAPP_API_TOKEN=
# TELEMED_WEBHOOK_SECRET=   # segredo HMAC combinado com a plataforma certificada
# TELEMED_API_URL=          # API da plataforma de telemedicina (criar sala)
# TELEMED_API_KEY=
# CRON_SECRET=              # protege a função de lembretes (ver supabase/cron.sql)
# SITE_URL=https://seudominio.com.br
# (SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já existem nas funções.)
